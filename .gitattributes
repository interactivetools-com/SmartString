# LF line endings for every text file; git detects binary files and leaves them alone
* text=auto eol=lf

# Exclude dev files from Packagist, Composer, and git archives for leaner installs.
.editorconfig    export-ignore
.gitattributes   export-ignore
.github/**       export-ignore
.gitignore       export-ignore
benchmarks       export-ignore
docs/**          export-ignore
logo.svg         export-ignore
phpunit.xml.dist export-ignore
tests            export-ignore
tools            export-ignore

# Except the AI reference: coding assistants read vendor/itools/smartstring/ locally,
# and this one file teaches them the whole API.
docs/ai-reference.md -export-ignore

# And the benchmark and the table helper it requires: the performance page
# invites everyone to run it, so both ship in Composer installs too (the
# directory line un-prunes the path so the file rules below can apply).
.github/scripts -export-ignore
.github/scripts/speed-page-table.php -export-ignore
.github/scripts/shared-md-table.php  -export-ignore
